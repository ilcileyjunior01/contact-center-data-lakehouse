# =========================================================
# Airflow — Contact Center Data Lakehouse
# Copie para .env e preencha com seus valores reais
# NUNCA commite o .env no git
# =========================================================

# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Projeto
BUCKET_NAME=act-cc-dev-lakehouse
ENV=dev
GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/GlueServiceRole-ContactCenter

# Redshift Serverless
REDSHIFT_HOST=your-workgroup.123456789012.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=...
REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftS3CopyRole

# Airflow
AIRFLOW_UID=50000
